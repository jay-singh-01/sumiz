# Used by `npm run dev:emu`. The "demo-" project id tells Firebase this is an
# emulator-only project: it can never reach real cloud data. Safe to commit.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-gota-dhaaga.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-gota-dhaaga
VITE_FIREBASE_APP_ID=demo-app-id
VITE_USE_EMULATORS=true
